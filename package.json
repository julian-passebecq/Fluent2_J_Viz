{
  "name": "@vizforge/engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Semantic D3 analytical figures and deterministic editorial stories",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./react": {
      "types": "./dist/lib/adapters/react.d.ts",
      "import": "./dist/lib/adapters/react.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/browser.mjs test",
    "browser:install": "node scripts/browser.mjs install chromium",
    "examples:export": "tsx scripts/export-examples.ts",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.md .github/workflows/*.yml",
    "validate": "tsx scripts/validate-examples.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run validate && npm run test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.4",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
