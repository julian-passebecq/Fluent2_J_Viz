{
  "name": "@vizforge/engine",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Semantic D3 analytical figures and deterministic editorial stories",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./react": {
      "types": "./dist/lib/adapters/react.d.ts",
      "import": "./dist/lib/adapters/react.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/browser.mjs test",
    "browser:install": "node scripts/browser.mjs install chromium",
    "examples:export": "tsx scripts/export-examples.ts",
    "format": "prettier --write src tests scripts/browser.mjs scripts/audit-bundle.mjs scripts/validate-examples.ts scripts/export-examples.ts *.ts *.json *.html *.md .github/workflows/*.yml",
    "validate": "tsx scripts/validate-examples.ts",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.lib.json && node scripts/audit-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "pnpm validate && pnpm test && pnpm build && pnpm test:e2e",
    "framework:bootstrap": "node --experimental-strip-types scripts/bootstrap-framework.ts",
    "framework:verify": "node --experimental-strip-types scripts/bootstrap-framework.ts --verify",
    "release:gate": "node --experimental-strip-types scripts/consumer-release-gate.ts",
    "validate:content": "pnpm validate",
    "test:unit": "vitest run",
    "test:browser": "pnpm test:e2e"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@datapass/code": "workspace:*",
    "@datapass/content": "workspace:*",
    "@datapass/figure": "workspace:*",
    "@datapass/ui": "workspace:*",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.4",
    "@types/node": "22.13.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.19.3",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@11.19.0",
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  }
}
